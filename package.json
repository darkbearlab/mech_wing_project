{
  "name": "mech-wing",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev -w @mech/server\" \"npm:dev -w @mech/client\"",
    "test": "vitest run",
    "typecheck": "tsc -p packages/rules && tsc -p apps/server && tsc -p apps/client && tsc -p apps/api",
    "sim": "tsx packages/rules/scripts/sim.ts",
    "aisim": "tsx packages/rules/scripts/aisim.ts",
    "content:check": "tsx packages/rules/scripts/content-check.ts",
    "battle": "tsx packages/rules/scripts/battle.ts",
    "seat": "npm run seat -w @mech/server --",
    "seat-wait": "npm run seat-wait -w @mech/server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}